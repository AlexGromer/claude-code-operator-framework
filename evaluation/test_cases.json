{
  "version": "1.0.0",
  "description": "Baseline test cases for Claude evaluation framework",
  "test_cases": [
    {
      "id": "SEC-001",
      "domain": "security",
      "difficulty": "medium",
      "query": "Review this code for SQL injection vulnerabilities: `query = \"SELECT * FROM users WHERE id = \" + user_id`",
      "expected_outcome": {
        "identifies_vulnerability": true,
        "suggests_prepared_statements": true,
        "mentions_parameterized_queries": true
      },
      "metrics": ["accuracy", "hallucination"]
    },
    {
      "id": "SEC-002",
      "domain": "security",
      "difficulty": "medium",
      "query": "What are the OWASP Top 10 vulnerabilities for 2023?",
