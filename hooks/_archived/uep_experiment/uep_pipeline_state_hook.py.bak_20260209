#!/usr/bin/env python3
"""
UEP Pipeline State Hook

PostToolUse hook for Task tool: logs pipeline state, tracks subagent results,
monitors DAG progress for the Universal Execution Pipeline.

Hook Type: PostToolUse
Matcher: Task
Blocking: false
Timeout: 1500ms
"""

import sys
import json
import os
import fcntl
from datetime import datetime, timezone
from pathlib import Path

DATA_DIR = Path.home() / ".claude" / "evaluation" / "data"
STATE_FILE = DATA_DIR / "uep_pipeline_state.jsonl"
RESUME_FILE = DATA_DIR / "uep_resume_state.json"


def main():
    """Track UEP pipeline state after Task tool execution."""
    try:
        # Read hook input from stdin
        try:
            input_data = json.load(sys.stdin)
        except Exception:
            input_data = {}

        tool_name = input_data.get("tool_name", os.environ.get("CLAUDE_TOOL_NAME", ""))

        # Only process Task tool calls
        if tool_name != "Task":
            print(json.dumps({}))
            sys.exit(0)

        tool_input = input_data.get("tool_input", {})
        tool_response = input_data.get("tool_response", "")

        # Extract task metadata
        description = ""
        subagent_type = ""
        model = ""
        if isinstance(tool_input, dict):
            description = tool_input.get("description", "")
            subagent_type = tool_input.get("subagent_type", "")
            model = tool_input.get("model", "")
        elif isinstance(tool_input, str):
            try:
                parsed = json.loads(tool_input)
                description = parsed.get("description", "")
                subagent_type = parsed.get("subagent_type", "")
                model = parsed.get("model", "")
            except Exception:
                pass

        # Determine result status
        response_str = str(tool_response)[:500] if tool_response else ""
        success = "error" not in response_str.lower()[:200]

        # Build state entry
        session_id = os.environ.get("CLAUDE_SESSION_ID", "")
        if not session_id:
            sid_file = DATA_DIR / "current_session_id"
            try:
                session_id = sid_file.read_text().strip()
            except Exception:
                session_id = "unknown"

        entry = {
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "session_id": session_id,
            "description": description[:100],
            "subagent_type": subagent_type,
            "model": model or "inherited",
            "success": success,
            "response_preview": response_str[:200],
        }

        # Append to state log (append-only, POSIX-safe)
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        with open(STATE_FILE, "a") as f:
            f.write(json.dumps(entry) + "\n")

        print(json.dumps({}))

    except Exception as e:
        print(json.dumps({"error": str(e)}), file=sys.stderr)
        print(json.dumps({}))

    sys.exit(0)


if __name__ == "__main__":
    main()
